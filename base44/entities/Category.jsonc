{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category display name",
      "minLength": 1,
      "maxLength": 80
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique slug",
      "pattern": "^[a-z0-9-]+$"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent category id for hierarchy (null = top level)"
    },
    "description": {
      "type": "string",
      "description": "Short description shown in browse UI"
    },
    "icon": {
      "type": "string",
      "description": "Optional lucide icon name"
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "good",
        "service",
        "any"
      ],
      "default": "any"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}