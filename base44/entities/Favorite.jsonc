{
  "name": "Favorite",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "Reference to the favorited Listing record"
    },
    "listing_title": {
      "type": "string",
      "description": "Denormalized listing title snapshot for fast display"
    },
    "listing_image": {
      "type": "string",
      "format": "uri",
      "description": "Denormalized cover image snapshot for fast display"
    },
    "listing_price": {
      "type": "number",
      "description": "Denormalized price snapshot"
    },
    "listing_currency": {
      "type": "string",
      "description": "Denormalized currency snapshot"
    },
    "listing_status": {
      "type": "string",
      "description": "Denormalized listing status snapshot"
    }
  },
  "required": [
    "listing_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}