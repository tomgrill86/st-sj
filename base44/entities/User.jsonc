{
  "name": "User",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "Public marketplace handle (legacy display name)"
    },
    "username": {
      "type": "string",
      "description": "Unique public marketplace handle, e.g. @vendra_user",
      "pattern": "^[a-zA-Z0-9_]{3,30}$"
    },
    "avatar_url": {
      "type": "string",
      "format": "uri",
      "description": "Profile picture URL"
    },
    "bio": {
      "type": "string",
      "description": "Seller biography / about text"
    },
    "country": {
      "type": "string",
      "description": "ISO country code or country name"
    },
    "city_or_region": {
      "type": "string",
      "description": "City or region within the country"
    },
    "location": {
      "type": "string",
      "description": "General location string (legacy free-text)"
    },
    "preferred_currency": {
      "type": "string",
      "default": "USD",
      "description": "ISO 4217 currency code the user prefers to transact in"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone (optional)"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "description": "Personal or business website"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Admin-granted verified seller badge"
    },
    "seller_since": {
      "type": "string",
      "format": "date",
      "description": "Date the user became a seller"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Account status (active / suspended). Admin-managed."
    },
    "seller_rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "default": 0,
      "description": "Aggregate seller rating (0-5). Managed server-side only."
    },
    "buyer_rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "default": 0,
      "description": "Aggregate buyer rating (0-5). Managed server-side only."
    },
    "completed_sales_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Number of completed sales. Managed server-side only."
    },
    "completed_purchases_count": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Number of completed purchases. Managed server-side only."
    }
  },
  "required": []
}